{
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "operators.rhodes.monster"
        }
      ],
      "destination": "/operators",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "terminal.rhodes.monster"
        }
      ],
      "destination": "/terminal",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "terra.rhodes.monster"
        }
      ],
      "destination": "/terra",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "translation.rhodes.monster"
        }
      ],
      "destination": "/translate",
      "permanent": false
    },
    {
      "source": "/server.ts",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/server.cjs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/server.cjs.map",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
