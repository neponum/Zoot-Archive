{
  "trailingSlash": false,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "operators.rhodes.monster"
        }
      ],
      "destination": "/operators",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "terminal.rhodes.monster"
        }
      ],
      "destination": "/terminal",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "terra.rhodes.monster"
        }
      ],
      "destination": "/terra",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "translation.rhodes.monster"
        }
      ],
      "destination": "/translate",
      "permanent": false
    },
    {
      "source": "/server.ts",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/server.cjs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/server.cjs.map",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/terminal",
      "destination": "/terminal/index.html"
    },
    {
      "source": "/story/map",
      "destination": "/story/map/index.html"
    },
    {
      "source": "/story/grid",
      "destination": "/story/grid/index.html"
    },
    {
      "source": "/chapters",
      "destination": "/chapters/index.html"
    },
    {
      "source": "/operators",
      "destination": "/operators/index.html"
    },
    {
      "source": "/translate",
      "destination": "/translate/index.html"
    },
    {
      "source": "/integrated-strategies",
      "destination": "/integrated-strategies/index.html"
    },
    {
      "source": "/reclamation-algorithm",
      "destination": "/reclamation-algorithm/index.html"
    },
    {
      "source": "/terra",
      "destination": "/terra/index.html"
    },
    {
      "source": "/storage",
      "destination": "/storage/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer/index.html"
    },
    {
      "source": "/takedown",
      "destination": "/takedown/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
